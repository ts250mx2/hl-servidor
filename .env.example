# ── Base de datos BDHLServer ───────────────────────────────────────────
DB_HOST=localhost
DB_USER=hladministrador
DB_PASSWORD=HL2026Llaves
DB_NAME=BDHLServer
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# ── Puerto del portal / webservice ────────────────────────────────────
# Se ignora si el script pasa --port (dev=3055, start=3056)
PORT=

# ── Llave maestra para cifrar las llaves de API (64 caracteres hex = 32 bytes) ──
# Genera una nueva con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambias, las llaves ya guardadas dejan de poder descifrarse.
MASTER_KEY=

# ── Secreto para firmar la cookie de sesión del portal ────────────────
SESSION_SECRET=

# ── Solo poner en true si el portal corre detrás de un proxy inverso (nginx/IIS)
# que reescribe X-Forwarded-For. Con false la IP se toma del socket real.
TRUST_PROXY=false
